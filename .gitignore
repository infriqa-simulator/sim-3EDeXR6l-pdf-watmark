# Node.js .gitignore

# Node modules
node_modules/

# Logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Build output
dist/
build/
out/

# Temporary files
*.tmp
*.temp

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS-specific files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
Desktop.ini

# Cache directories
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory used by tools like istanbul
coverage/

# Miscellaneous
__pycache__/
*.tgz
*.gz
*.zip
*.tar
*.rar
!package.json
!package-lock.json
!requirements.txt
!*.yml

# InfrIQa generated manifest
.infriqa/


# OpenTofu / Terraform local files
tofu/.terraform/
tofu/*.tfstate
tofu/*.tfstate.*
tofu/tofu.tfvars
tofu/terraform.tfvars
tofu/crash.log
